"""
PART 2: Node Identification, Region Mapping, and NetworkX Graph Construction
Result: Topologically Connected Road Network Graph
"""

import networkx as nx
import numpy as np
from scipy.ndimage import label
from scipy.signal import convolve2d

# 1. Detect Endpoints & Junctions
kernel = np.ones((3, 3), dtype=np.uint8)
neighbor_count = convolve2d(skeleton, kernel, mode="same")
neighbor_count -= skeleton

endpoints = (skeleton == 1) & (neighbor_count == 1)
junction_pixels = (skeleton == 1) & (neighbor_count >= 3)

# Merge Junction Pixels into Central Nodes
structure = np.ones((3, 3), dtype=np.uint8)
labeled_junctions, num_junctions = label(
    junction_pixels.astype(np.uint8), structure=structure
)

intersection_nodes = []
for i in range(1, num_junctions + 1):
    ys, xs = np.where(labeled_junctions == i)
    center_x = int(np.mean(xs))
    center_y = int(np.mean(ys))
    intersection_nodes.append((center_x, center_y))

# Build Final Node List
node_positions = {}
node_id = 0

ey, ex = np.where(endpoints)
for x, y in zip(ex, ey):
    node_positions[node_id] = (x, y)
    node_id += 1

for x, y in intersection_nodes:
    node_positions[node_id] = (x, y)
    node_id += 1

# 2. Create Node Regions
NODE_RADIUS = 8
node_region_map = np.full(skeleton.shape, -1, dtype=np.int32)
Y, X = np.indices(skeleton.shape)

for n_id, (x, y) in node_positions.items():
    region = ((X - x) ** 2 + (Y - y) ** 2) <= NODE_RADIUS**2
    node_region_map[region] = n_id

# 3. Segment Extraction & Connection
road_segments = skeleton.copy()
road_segments[node_region_map != -1] = 0
segment_labels, num_segments = label(
    road_segments, structure=np.ones((3, 3), dtype=np.uint8)
)

segment_to_nodes = {}
for segment_id in range(1, num_segments + 1):
    ys, xs = np.where(segment_labels == segment_id)
    connected_nodes = set()

    for y, x in zip(ys, xs):
        for dy in [-1, 0, 1]:
            for dx in [-1, 0, 1]:
                ny, nx_pos = y + dy, x + dx
                if 0 <= ny < skeleton.shape[0] and 0 <= nx_pos < skeleton.shape[1]:
                    node = node_region_map[ny, nx_pos]
                    if node != -1:
                        connected_nodes.add(node)

    segment_to_nodes[segment_id] = list(connected_nodes)

# 4. Construct NetworkX Graph
G = nx.Graph()
for n_id, position in node_positions.items():
    G.add_node(n_id, pos=position)

for segment_id, nodes in segment_to_nodes.items():
    if len(nodes) != 2:
        continue
    n1, n2 = nodes
    length = np.sum(segment_labels == segment_id)
    G.add_edge(n1, n2, weight=float(length))

print("=== GRAPH CONSTRUCTED ===")
print("Total Nodes :", G.number_of_nodes())
print("Total Edges :", G.number_of_edges())
